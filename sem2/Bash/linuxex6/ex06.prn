      read INPUT_STRING
      case $INPUT_STRING in
	 hello)
	    echo "Hello yourself!"
	    ;;
	 bye)
	    echo "See you again!"
	    break
	    ;;
	 *)
	    echo "sorry, I dont understand"
	    ;;
      esac
   done
   echo "
   Thats all folks!"
